@FT-02-US-01 @layer:api
Feature: 创建编织项目 - API 层 # features/api/project-create.api.feature:3
  作为一个已登录的织友用户，
  我想要创建一个新的编织项目（填写名称与预计完成日期，可选填里程碑），
  以便为每段编织旅程建立档案，后续在看板上追踪它的状态。
  Background:   # features/api/project-create.api.feature:16

  @api:contract @AC-1
  Scenario: AC-1 接口契约 - 登录用户创建项目成功初始状态为待开始并出现在本人列表  # features/api/project-create.api.feature:23
    Given 请求基础地址为 "http://localhost:8080"           # steps/user_login_api_steps.py:46
    Given 用户 "woolenwhimsy" 使用密码 "knit123" 已登录      # steps/project_create_api_steps.py:32
    When 发送 POST 请求 "/api/v1/projects"，请求体如下        # steps/user_login_api_steps.py:122
      """
      {
        "name": "祖母的生日披肩",
        "dueDate": "2026-10-31"
      }
      """
    Then 响应状态码为 201                                 # steps/user_login_api_steps.py:135
    And 响应中项目名称为 "祖母的生日披肩"                          # steps/project_create_api_steps.py:62
    And 响应中项目状态为 "todo"                             # steps/project_create_api_steps.py:68
    And 响应中里程碑列表为空                                  # steps/project_create_api_steps.py:74
    When 发送 GET 请求 "/api/v1/projects"               # steps/project_create_api_steps.py:50
    Then 响应状态码为 200                                 # steps/user_login_api_steps.py:135
    And 本人项目列表包含名称为 "祖母的生日披肩" 且状态为 "todo" 的项目       # steps/project_create_api_steps.py:112

  @api:contract @AC-2
  Scenario: AC-2 接口契约 - 携带里程碑创建成功按顺序排列且均未完成    # features/api/project-create.api.feature:44
    Given 请求基础地址为 "http://localhost:8080"      # steps/user_login_api_steps.py:46
    Given 用户 "woolenwhimsy" 使用密码 "knit123" 已登录 # steps/project_create_api_steps.py:32
    When 发送 POST 请求 "/api/v1/projects"，请求体如下   # steps/user_login_api_steps.py:122
      """
      {
        "name": "圣诞袜",
        "dueDate": "2026-12-24",
        "milestones": [
          {"name": "织袜筒", "dueDate": "2026-12-01"},
          {"name": "收口"}
        ]
      }
      """
    Then 响应状态码为 201                            # steps/user_login_api_steps.py:135
    And 响应中项目名称为 "圣诞袜"                         # steps/project_create_api_steps.py:62
    And 响应中里程碑列表为                              # steps/project_create_api_steps.py:80
      | name | dueDate    | completed |
      | 织袜筒  | 2026-12-01 | false     |
      | 收口   |            | false     |

  @api:error @AC-3
  Scenario: AC-3 错误码 - 项目名称为空返回 400 提示必填       # features/api/project-create.api.feature:68
    Given 请求基础地址为 "http://localhost:8080"      # steps/user_login_api_steps.py:46
    Given 用户 "woolenwhimsy" 使用密码 "knit123" 已登录 # steps/project_create_api_steps.py:32
    When 发送 POST 请求 "/api/v1/projects"，请求体如下   # steps/user_login_api_steps.py:122
      """
      {
        "name": "",
        "dueDate": "2026-11-15"
      }
      """
    Then 响应状态码为 400                            # steps/user_login_api_steps.py:135
    And 返回如下错误信息                               # steps/user_login_api_steps.py:165
      """
      {
        "message": "请填写项目名称"
      }
      """
    When 发送 GET 请求 "/api/v1/projects"          # steps/project_create_api_steps.py:50
    Then 本人项目列表不包含名称为 "祖母的生日披肩" 的项目            # steps/project_create_api_steps.py:123

  @api:error @AC-3
  Scenario: AC-3 错误码 - 未选择预计完成日期返回 400 提示必填    # features/api/project-create.api.feature:89
    Given 请求基础地址为 "http://localhost:8080"      # steps/user_login_api_steps.py:46
    Given 用户 "woolenwhimsy" 使用密码 "knit123" 已登录 # steps/project_create_api_steps.py:32
    When 发送 POST 请求 "/api/v1/projects"，请求体如下   # steps/user_login_api_steps.py:122
      """
      {
        "name": "围巾"
      }
      """
    Then 响应状态码为 400                            # steps/user_login_api_steps.py:135
    And 返回如下错误信息                               # steps/user_login_api_steps.py:165
      """
      {
        "message": "请选择预计完成日期"
      }
      """

  @api:error @AC-4
  Scenario: AC-4 错误码 - 里程碑名称为空返回 400 提示必填      # features/api/project-create.api.feature:109
    Given 请求基础地址为 "http://localhost:8080"      # steps/user_login_api_steps.py:46
    Given 用户 "woolenwhimsy" 使用密码 "knit123" 已登录 # steps/project_create_api_steps.py:32
    When 发送 POST 请求 "/api/v1/projects"，请求体如下   # steps/user_login_api_steps.py:122
      """
      {
        "name": "圣诞袜",
        "dueDate": "2026-12-24",
        "milestones": [
          {"name": ""}
        ]
      }
      """
    Then 响应状态码为 400                            # steps/user_login_api_steps.py:135
    And 返回如下错误信息                               # steps/user_login_api_steps.py:165
      """
      {
        "message": "里程碑名称必填"
      }
      """

  @api:error @AC-5
  Scenario: AC-5 错误码 - 未登录创建项目返回 401         # features/api/project-create.api.feature:133
    Given 请求基础地址为 "http://localhost:8080"    # steps/user_login_api_steps.py:46
    Given 请求认证状态为 "未登录"                      # steps/user_login_api_steps.py:59
    When 发送 POST 请求 "/api/v1/projects"，请求体如下 # steps/user_login_api_steps.py:122
      """
      {
        "name": "祖母的生日披肩",
        "dueDate": "2026-10-31"
      }
      """
    Then 响应状态码为 401                          # steps/user_login_api_steps.py:135

